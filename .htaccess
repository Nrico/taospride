# GoDaddy shared hosting — SPA routing + PHP API passthrough
Options -MultiViews

# ── Gzip compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain text/xml
</IfModule>

# ── Browser caching ───────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Vite assets include content hashes — cache forever
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  # Images
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 1 month"
  ExpiresByType image/webp            "access plus 1 month"
  ExpiresByType image/svg+xml         "access plus 1 month"
  # HTML and API — always revalidate
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# ── Routing ───────────────────────────────────────────────────────────────────
RewriteEngine On
RewriteBase /

# Let PHP API handle itself
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Static assets pass through
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Gallery SPA — deliberately explicit rather than relying on directory
# descent into gallery/.htaccess: descent only kicks in when the literal
# path is a real directory, which breaks for multi-segment client-routed
# paths like /gallery/2025/pride-on-plaza (not a real directory). This
# rule catches those before they'd otherwise fall through to the rule below
# and serve the *main* site's index.html instead of gallery's.
RewriteRule ^gallery(/.*)?$ gallery/index.html [L]

# Everything else → SPA index.html
RewriteRule ^ index.html [L]
